{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "ignorePaths": [
    ".git",
    ".gitignore",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".uv-cache",
    ".venv",
    "cspell.json",
    "Makefile",
    "node_modules",
    "package-lock.json",
    "pyproject.toml",
    "tox.ini",
    "uv.lock"
  ],
  "files": [
    "**/*.{md,py,toml,json,yml,yaml}"
  ],
  "dictionaries": [
    "python"
  ],
  "words": [
    "allclose",
    "aquarelle",
    "ascontiguousarray",
    "asfortranarray",
    "atleast",
    "biuf",
    "BLAS",
    "brushmarks",
    "capsys",
    "Catmull",
    "CIELAB",
    "corrcoef",
    "embeddeddolt",
    "errstate",
    "fastmath",
    "fftfreq",
    "flatnonzero",
    "fromarray",
    "frombuffer",
    "fusain",
    "htmlcov",
    "huile",
    "IDAT",
    "IEND",
    "IHDR",
    "IIBB",
    "IIBBBBB",
    "interp",
    "intp",
    "issubdtype",
    "itemsize",
    "joce",
    "keepdims",
    "Kubelka",
    "LANCZOS",
    "latewood",
    "Legault",
    "LHTSS",
    "libm",
    "linalg",
    "lrgb",
    "masstone",
    "mgrid",
    "moveaxis",
    "Munk",
    "murex",
    "nextafter",
    "njit",
    "nonnull",
    "oilpaint",
    "phthalo",
    "refcounts",
    "rfft",
    "rint",
    "rrggbb",
    "rtol",
    "smudger",
    "sRGB",
    "stilllife",
    "subpackage",
    "subpackages",
    "Tarjan",
    "tobytes",
    "tortillon"
  ],
  "ignoreRegExpList": [
    "0x[0-9a-f]\\.[0-9a-f]+p[-+]?\\d+",
    "\\b[0-9a-f]{64}\\b"
  ]
}
