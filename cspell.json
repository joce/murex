    "fromarray",
    "frombuffer",
    "fusain",
    "htmlcov",
    "IDAT",
    "IEND",
    "IHDR",
    "IIBB",
    "IIBBBBB",
    "interp",
    "issubdtype",
    "itemsize",
    "joce",
    "keepdims",
    "Kubelka",
    "LANCZOS",
    "latewood",
    "Legault",
    "LHTSS",
    "linalg",
    "lrgb",
    "masstone",
    "mgrid",
    "Munk",
    "murex",
    "njit",
    "oilpaint",
    "phthalo",
    "rrggbb",
    "rtol",
    "sRGB",
    "tobytes"
  ]
